---
import Base from '../layouts/Base.astro';
---

<Base
  title="Page not found | Biomaxxer"
  description="That page does not exist. Head back to the Biomaxxer homepage for the community, the consultation, and every link."
  noindex
>
  <section class="section">
    <div class="container">
      <p class="eyebrow">404</p>
      <h1 class="h2">No page here.</h1>
      <p class="lede">
        The address is wrong or the page moved. Everything worth finding is
        one click away.
      </p>
      <div class="cta-row">
        <a class="btn btn--primary" href="/">Back to the homepage</a>
        <a class="btn btn--secondary" href="/links">See every link</a>
      </div>
    </div>
  </section>
</Base>
