---
import { getCollection } from 'astro:content';
import Icon from './Icon.astro';
import { SITE_NAME, DISCLAIMER } from '../config';

const socials = (await getCollection('links'))
  .filter((l) => l.data.kind === 'social')
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 5);

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="site-footer__top">
      <div>
        <p class="site-footer__wordmark">Biomaxxer</p>
        <ul class="site-footer__social" aria-label="Social profiles">
          {
            socials.map((s) => (
              <li>
                <a href={s.data.url} target="_blank" rel="noopener noreferrer" aria-label={s.data.label}>
                  <Icon name={s.data.icon as never} size={20} />
                </a>
              </li>
            ))
          }
        </ul>
      </div>
      <nav aria-label="Footer">
        <ul class="site-footer__nav">
          <li><a href="/">Home</a></li>
          <li><a href="/links">All links</a></li>
          <li><a href="/discord">Free Discord</a></li>
        </ul>
      </nav>
    </div>

    <div class="site-footer__disclaimer" role="note">
      <p class="site-footer__disclaimer-title">Disclaimer</p>
      <p>{DISCLAIMER}</p>
    </div>

    <p class="site-footer__legal">
      © {year} {SITE_NAME}. All rights reserved.
    </p>
  </div>
</footer>

<style>
  /* the helix hairline closes the page — the same red-to-blue arc the rail
     and the CTA panel carry */
  .site-footer {
    position: relative;
    background: var(--c-bg);
    padding-block: var(--sp-16) var(--sp-8);
  }

  .site-footer::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: var(--border-w);
    background: linear-gradient(90deg, var(--c-red), var(--c-accent));
    opacity: 0.55;
  }

  .site-footer__top {
    display: flex;
    flex-direction: column;
    gap: var(--sp-8);
  }

  @media (min-width: 768px) {
    .site-footer__top {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-start;
    }
  }

  .site-footer__wordmark {
    font-weight: var(--fw-black);
    letter-spacing: var(--tr-eyebrow);
    text-transform: uppercase;
  }

  .site-footer__social {
    display: flex;
    gap: var(--sp-4);
    list-style: none;
    margin: var(--sp-4) 0 0;
    padding: 0;
  }

  .site-footer__social a {
    display: inline-flex;
    padding: var(--sp-3); /* 20px icon + 12px padding = 44px touch target */
    color: var(--c-text-muted);
    transition: color var(--dur) var(--ease);
  }

  .site-footer__social a:hover {
    color: var(--c-accent);
  }

  .site-footer__nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-6);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-footer__nav a {
    color: var(--c-text-muted);
    text-decoration: none;
    font-size: var(--fs-small);
    transition: color var(--dur) var(--ease);
  }

  .site-footer__nav a:hover {
    color: var(--c-text);
  }

  /* Mandatory health-content disclaimer. {{DISCLAIMER}} wording comes from
     the client — placement ships now, launch blocks on the copy. */
  .site-footer__disclaimer {
    margin-top: var(--sp-12);
    padding: var(--sp-6);
    border: var(--border-w) solid var(--c-border);
    border-radius: var(--radius);
    color: var(--c-text-muted);
    font-size: var(--fs-small);
    max-width: var(--measure);
  }

  .site-footer__disclaimer-title {
    font-size: var(--fs-eyebrow);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--tr-eyebrow);
    text-transform: uppercase;
    margin-bottom: var(--sp-2);
    color: var(--c-text);
  }

  .site-footer__legal {
    margin-top: var(--sp-8);
    font-size: var(--fs-small);
    color: var(--c-text-muted);
  }
</style>
